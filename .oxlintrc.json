{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useTheme",
          "initializeTheme"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/shared/ui/*.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "tests/fixtures/*.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".agents/skills/**"
  ]
}
