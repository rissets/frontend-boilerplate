{
  "name": "frontend-boilerplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run tokens && npm run fonts && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run tokens -- --check && npm run architecture && npm run assets && npm run skills:check && npm run typecheck && npm run lint && npm test && npm run test:tooling",
    "test": "vitest run",
    "tokens": "node scripts/tokens.mjs",
    "fonts": "node scripts/fonts.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.md docs skills .impeccable/design.json --ignore-path .prettierignore",
    "test:browser": "playwright test",
    "create": "node scripts/create-project.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "assets": "node scripts/check-assets.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "ui:info": "npx --yes shadcn@4.22.1 info --json",
    "ui:docs": "npx --yes shadcn@4.22.1 docs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-spring/three": "10.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.7",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
